  598          // 参数说明       x               坐标x方向的起点 参数范围 [0, ips114_x_max-1]
  599          // 参数说明       y               坐标y方向的起点 参数范围 [0, ips114_y_max-1]
  600          // 参数说明       siz            取模的时候设置的汉字字体大小 也就是一个汉字占�
             -��的点阵长宽为多少个点 取模的时候需要长宽是一样的
  601          // 参数说明       *p              需要显示的汉字数组
  602          // 参数说明       number          需要显示多少位
  603          // 参数说明       color           显示颜色
  604          // 返回参数      void
  605          // 使用示例                ips114_show_chinese(0,0,16,chinese_test[0],4,RED);//显示font文件里面
             -的 示例
  606          // 备注信息                        使用PCtoLCD2002软件取模           阴码、逐行式、顺�
             -�   16*16
  607          //-------------------------------------------------------------------------------------------------------
             -------------
  608          void ips114_show_chinese (uint16 x, uint16 y, uint8 siz, const uint8 *p, uint8 number, uint16 color)
  609          {
  610   1      
  611   1          int i, j, k; 
  612   1          uint8 temp, temp1, temp2;
  613   1          const uint8 *p_data;
  614   1              
  615   1        zf_assert(x < ips114_x_max);
  616   1          zf_assert(y < ips114_y_max);
  617   1      
  618   1          temp2 = siz/8;
  619   1          
  620   1          ips114_set_region(x,y,number*siz-1+x,y+siz-1);
  621   1          
  622   1          for(i=0;i<siz;i++)
  623   1          {
  624   2              temp1 = number;
  625   2              p_data = p+i*temp2;
  626   2              while(temp1--)
  627   2              {
  628   3                  for(k=0;k<temp2;k++)
  629   3                  {
  630   4                      for(j=8;j>0;j--)
  631   4                      {
  632   5                          temp = (*p_data>>(j-1)) & 0x01;
  633   5                          if(temp)    ips114_write_16bit_data(color);
  634   5                          else        ips114_write_16bit_data(ips114_bgcolor);
  635   5                      }
  636   4                      p_data++;
  637   4                  }
  638   3                  p_data = p_data - temp2 + temp2*siz;
  639   3              }   
  640   2          }
  641   1      }
