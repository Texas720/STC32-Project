   38          void DMA_UART1_IRQHandler(void) interrupt DMA_UR1R_VECTOR
   39          {
   40   1          static vuint8 dwon_count = 0;
   41   1      
   42   1          if (DMA_UR1R_STA & 0x01) // 接收完成
   43   1          {
   44   2              DMA_UR1R_STA &= ~0x01;      // 清标志位
   45   2              uart_rx_start_buff(UART_1); // 设置下一次接收，务必保留
   46   2      
   47   2              // 程序自动下载
   48   2              if (uart_rx_buff[UART_1][0] == 0x7F)
   49   2              {
   50   3                  if (dwon_count++ > 20)
C251 COMPILER V5.60.0,  isr                                                                21/11/26  17:07:46  PAGE 2   

   51   3                  {
   52   4                      IAP_CONTR = 0x60;
   53   4                  }
   54   3              }
   55   2              else
   56   2              {
   57   3                  dwon_count = 0;
   58   3              }
   59   2      
   60   2              if (uart_rx_handlers[UART_1] != NULL)
   61   2              {
   62   3                  uart_rx_handlers[UART_1](uart_rx_buff[UART_1][0]);
   63   3              }
   64   2          }
   65   1      
   66   1          if (DMA_UR1R_STA & 0x02) // 数据丢弃
   67   1          {
   68   2              DMA_UR1R_STA &= ~0x02;      // 清标志位
   69   2              uart_rx_start_buff(UART_1); // 设置下一次接收，务必保留
   70   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
   71   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
   72   2              // 如果进入了这个中断，则代表UART的数据在没有取走之前被覆盖!
   73   2          }
