  421          // 函数简介       液晶显示浮点数(去除整数部分无效的0)
  422          // 参数说明       x               坐标x方向的起点 参数范围 [0, ips200_x_max-1]
  423          // 参数说明       y               坐标y方向的起点 参数范围 [0, ips200_y_max-1]
  424          // 参数说明       dat             需要显示的变量，数据类型float或double
  425          // 参数说明       num             整数位显示长度   最高10位
  426          // 参数说明       pointnum        小数位显示长度   最高6位
  427          // 返回参数       void
  428          // 使用示例                ips200_showfloat(0,0,x,2,3);                    // 显示浮点数   整�
             -�显示2位   小数显示三位
  429          // @note                        特别注意当发现小数部分显示的值与你写入的值不一样�
             -��时候，
  430          //                              可能是由于浮点数精度丢失问题导致的，这并不是显示�
             -��数的问题，
  431          //                              有关问题的详情，请自行百度学习   浮点数精度丢失问�
             -��。
  432          //                              负数会显示一个 ‘-’号   正数显示一个空格
  433          //-------------------------------------------------------------------------------------------------------
             -------------
  434          void ips200_show_float(uint16 x,uint16 y,double dat,uint8 num,uint8 pointnum)
  435          {
  436   1          uint8   length;
  437   1          int8    buff[34];
  438   1          int8    start,end,point;
  439   1        
  440   1          zf_assert(x < ips200_x_max);
  441   1          zf_assert(y < ips200_y_max);
  442   1      
  443   1          if(6<pointnum)  pointnum = 6;
  444   1          if(10<num)      num = 10;
  445   1              
  446   1          if(0>dat)   length = zf_sprintf( &buff[0],(const int8 *)"%f",dat);        // 负数
  447   1          else
  448   1          {
  449   2              length = zf_sprintf( &buff[1],(const int8 *)"%f",dat);
  450   2              length++;
  451   2          }
  452   1          point = length - 7;                                                         // 计算小数点位置
  453   1          start = point - num - 1;                                                    // 计算起始位
  454   1          end = point + pointnum + 1;                                                 // 计算结束位
  455   1          while(0>start)                                                              // 整数位不够  末�
             -�应该填充空格
  456   1          {
  457   2              buff[end] = ' ';
  458   2              end++;
  459   2              start++;
  460   2          }
  461   1          
  462   1          if(0>dat)   buff[start] = '-';
  463   1          else        buff[start] = ' ';
  464   1          
  465   1          buff[end] = '\0';
  466   1      
  467   1          ips200_show_string(x, y, (const char *)buff);                               // 显示数字
  468   1      }
